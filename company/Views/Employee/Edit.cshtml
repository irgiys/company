@model company.Models.EmployeeModel

<div>
    <h1>Edit Employee</h1>
    <div class="m-2">
        <form class="d-flex flex-column gap-2" asp-action="Edit" method="post">
            <div class="">
                <label for="nik">NIK</label>
                <input type="text" id="nik" asp-for="nik" class="form-control"/>
            </div>
            <div class="">
                <label for="name">Name</label>
                <input type="text" id="name" asp-for="name" class="form-control"/>
            </div>
            <div class="">
                <label for="emali">Email</label>
                <input type="email" id="email" asp-for="email" class="form-control"/>
            </div>
            <div class="">
                <label for="division">Division</label>
                <input type="text" id="division" asp-for="division" class="form-control"/>
            </div>
            <div class="">
                <label for="Salary">Salary</label>
                <input type="number" id="Salary" asp-for="salary" class="form-control"/>
            </div>
            <button type="submit" class="btn btn-primary">
                Update
            </button>
            <a asp-action="Employee" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>